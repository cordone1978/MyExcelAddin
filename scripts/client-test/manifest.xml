<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>f7e3465d-3425-4bf6-b4cc-ec940ee88851</Id>
  <Version>1.0.0.133</Version>
  <ProviderName>WellStone</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="报价系统"/>
  <Description DefaultValue="报价系统加载项"/>
  <IconUrl DefaultValue="https://quotation-vm.test:3001/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://quotation-vm.test:3001/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.hnhtft.com.cn"/>
  <AppDomains>
    <AppDomain>https://quotation-vm.test:3001</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://quotation-vm.test:3001/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <!-- 添加你的自定义组 -->
              <Group id="CustomGroup">
                <Label resid="CustomGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <!-- 原始的任务窗格按钮 -->
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://quotation-vm.test:3001/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://quotation-vm.test:3001/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://quotation-vm.test:3001/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Commands.Url" DefaultValue="https://quotation-vm.test:3001/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://quotation-vm.test:3001/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="欢迎使用报价系统"/>
        <bt:String id="CustomGroup.Label" DefaultValue="我的加载项"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="报价系统"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="报价系统加载成功，请在“开始”选项卡中点击按钮开始使用。"/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="打开报价系统"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>

